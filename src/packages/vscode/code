#!/bin/sh
export DOTNET_EnableDiagnostics=0
if [ "${ELECTRON_RUN_AS_NODE:-0}" = 1 ]; then
    exec /usr/share/code/code.bin --single-threaded-gc "$@"
fi
exec /usr/share/code/code.bin \
    --js-flags=--single-threaded-gc \
    --use-gl=angle --use-angle=gl \
    --hardware-video-device-path=/dev/dri/renderD128 \
    --ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy \
    --enable-features=AcceleratedVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks \
    "$@"
