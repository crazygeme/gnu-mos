 int XPending (register Display *dpy)
 {
     int ret_val;
+#ifdef XTHREADS
+    int cancel_state;
+    /* Nonblocking event queries restore cancellation after releasing the lock. */
+    pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &cancel_state);
+#endif
     LockDisplay(dpy);
     if (dpy->qlen)
 	ret_val = dpy->qlen;
     else
 	ret_val = _XEventsQueued (dpy, QueuedAfterFlush);
     UnlockDisplay(dpy);
+#ifdef XTHREADS
+    pthread_setcancelstate(cancel_state, NULL);
+#endif
     return ret_val;
 }
