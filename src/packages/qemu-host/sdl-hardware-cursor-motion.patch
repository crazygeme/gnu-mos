+/* Relative hardware-cursor input is accumulated in guest coordinates. */
+static void sdl_pointer_align(struct sdl2_console *scon, int x, int y)
+{
+    int w, h, sw = surface_width(scon->surface);
+    int sh = surface_height(scon->surface);
+    SDL_GetWindowSize(scon->real_window, &w, &h);
+    if (w <= 0 || h <= 0 || sw <= 0 || sh <= 0) {
+        return;
+    }
+    scon->pointer_x = x;
+    scon->pointer_y = y;
+    scon->pointer_valid = true;
+    scon->pointer_pending = false;
+    scon->pointer_input_ticks = SDL_GetTicks();
+    SDL_WarpMouseInWindow(scon->real_window,
+                         (int64_t)x * w / sw, (int64_t)y * h / sh);
+}
+
+static void sdl_pointer_feedback(struct sdl2_console *scon, int x, int y)
+{
+    uint32_t idle = SDL_GetTicks() - scon->pointer_input_ticks;
+    if (!gui_grab || !guest_cursor || !scon->pointer_valid ||
+        qemu_input_is_absolute(scon->dcl.con) || absolute_enabled) {
+        return;
+    }
+    if (x == scon->pointer_x && y == scon->pointer_y) {
+        scon->pointer_pending = false;
+    } else if (idle >= 100 &&
+               (!scon->pointer_pending ||
+                (idle >= 500 && SDL_GetTicks() -
+                 scon->pointer_feedback_ticks >= 100))) {
+        /* Quiescent guest warps are distinct from input acknowledgements. */
+        sdl_pointer_align(scon, x, y);
+    }
+}
