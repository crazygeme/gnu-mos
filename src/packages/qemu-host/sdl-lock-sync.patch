--- a/ui/sdl2-input.c
+++ b/ui/sdl2-input.c
@@ -29,6 +29,44 @@
 #include "ui/sdl2.h"
 #include "trace.h"
 
+static int sdl2_guest_leds;
+
+static void sdl2_guest_led_change(void *opaque, int leds)
+{
+    sdl2_guest_leds = leds;
+}
+
+void sdl2_keyboard_init(void)
+{
+    qemu_add_led_event_handler(sdl2_guest_led_change, NULL);
+}
+
+void sdl2_sync_locks(struct sdl2_console *scon, SDL_Keymod mods)
+{
+    static const struct {
+        SDL_Keymod host;
+        int guest;
+        QKeyCode key;
+    } locks[] = {
+        { KMOD_CAPS, QEMU_CAPS_LOCK_LED, Q_KEY_CODE_CAPS_LOCK },
+        { KMOD_NUM, QEMU_NUM_LOCK_LED, Q_KEY_CODE_NUM_LOCK },
+    };
+    size_t i;
+
+    if (!qemu_console_is_graphic(scon->dcl.con)) {
+        return;
+    }
+    for (i = 0; i < G_N_ELEMENTS(locks); i++) {
+        if (!!(mods & locks[i].host) == !!(sdl2_guest_leds & locks[i].guest)) {
+            continue;
+        }
+        qkbd_state_key_event(scon->kbd, locks[i].key, true);
+        qkbd_state_key_event(scon->kbd, locks[i].key, false);
+        /* Keep events in one SDL batch consistent before guest LED feedback. */
+        sdl2_guest_leds ^= locks[i].guest;
+    }
+}
+
