#!/bin/sh
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
pidfile=/run/dbus/pid

running() {
    [ -s "$pidfile" ] || return 1
    read -r pid < "$pidfile"
    case "$pid" in
        '' | *[!0-9]* | 0 | 1) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null
}

case "$1" in
start)
    [ -x /usr/bin/dbus-daemon ] || exit 77
    running && exit 0
    mkdir -p /run/dbus /var/lib/dbus || exit 1
    chown root:messagebus /run/dbus || exit 1
    chmod 0755 /run/dbus /var/lib/dbus || exit 1
    dbus-uuidgen --ensure=/etc/machine-id || exit 1
    ln -sf /etc/machine-id /var/lib/dbus/machine-id || exit 1
    chown root:messagebus /usr/libexec/dbus-daemon-launch-helper || exit 1
    chmod 4750 /usr/libexec/dbus-daemon-launch-helper || exit 1
    rm -f "$pidfile" /run/dbus/system_bus_socket
    exec /usr/bin/dbus-daemon --system --fork
    ;;
stop)
    running || exit 0
    kill -TERM "$pid"
    ;;
*)
    printf '%s\n' 'Usage: dbus {start|stop}' >&2
    exit 1
    ;;
esac
